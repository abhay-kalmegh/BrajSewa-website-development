# --- Frontend ----------------------------------------------------------------------------------
# Django API origin. Set this in Vercel for Preview/Production; Next.js uses it server-side and for the /api rewrite.
# The rewrite is baked into Next.js at build time, so update it before rebuilding a Docker image.
NEXT_PUBLIC_API_URL=https://brajsewa-website-development.onrender.com
# true in production (cookies get the Secure flag). The server refuses insecure cookies in production unless
# ALLOW_INSECURE_COOKIES=true (dev override only).
AUTH_COOKIE_SECURE=true
# Extra hostnames next/image may load, comma-separated (e.g. your CDN).
IMAGE_HOSTS=
# Browser security headers, resolved at BUILD time (docker build args). The CSP starts in report-only mode; set
# CSP_ENFORCE=true and rebuild once a week of staging reports shows no legitimate violations.
CSP_ENFORCE=false
CSP_REPORT_URI=
HSTS_MAX_AGE_SECONDS=3600       # raise to 31536000 once HTTPS is verified everywhere
HSTS_INCLUDE_SUBDOMAINS=false

# --- Django --------------------------------------------------------------------------------------
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production refuses to start if either is short/repetitive, or if they are the same value.
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_DEBUG=false
# Refresh-token lifetime in days (1-30, default 3). docker-compose feeds Django (JWT_REFRESH_DAYS) and Next.js
# (AUTH_REFRESH_DAYS) from this one value so they cannot drift apart. Shorter = a stolen token is useful for less time.
SESSION_REFRESH_DAYS=3
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# true in production (HTTPS redirect, secure cookies, HSTS). Production refuses to start with it false unless
# DJANGO_ALLOW_INSECURE_HTTP=true, which only docker-compose.override.yml (dev) sets.
DJANGO_HTTPS_ONLY=true
CORS_ALLOWED_ORIGINS=           # leave empty: the browser never calls Django directly
CSRF_TRUSTED_ORIGINS=
# Number of reverse proxies in front of Django (used for per-IP rate limiting). See backend/README.md.
API_NUM_PROXIES=1            # Next.js is the one proxy in front of Django. Leave unset and per-IP limits can be bypassed.
FRONTEND_BIND=127.0.0.1         # interface the frontend port is published on; keep loopback behind a TLS proxy
TRUSTED_PROXY_HOPS=1         # proxies in front of Next.js: CloudFront + ALB = 2, ALB only = 1
# Shared cache for rate-limit counters. Required in production with more than one worker.
REDIS_URL=
# Optional: move the admin away from /admin/
DJANGO_ADMIN_PATH=admin/

# --- Postgres ------------------------------------------------------------------------------------
POSTGRES_DB=brajsewa
POSTGRES_USER=brajsewa
POSTGRES_PASSWORD=
REDIS_PASSWORD=                 # required; URL-safe, e.g. openssl rand -hex 24
# Two roles (see backend/scripts/db_roles.sql): POSTGRES_USER is the app role (no DDL); migrations use the owner role.
MIGRATE_POSTGRES_USER=
MIGRATE_POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require        # 'prefer' only for a local container; RDS should be 'require' or 'verify-full'
DB_CONN_MAX_AGE=60
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Razorpay (server-side only) -----------------------------------------------------------------
# Test keys (rzp_test_...) are refused outside DEBUG unless RAZORPAY_ALLOW_TEST_KEYS=true (staging); live keys are refused in DEBUG.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Seller order notifications ----------------------------------------------------------------
# Local DEBUG defaults to Django's console email backend. Production requires SMTP configuration.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@brajsewa.com
# Meta WhatsApp Business Cloud API. Template body variables: order number, seller item count, seller subtotal INR.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# MSG91 Flow API. Approved DLT template variables: order number, seller item count, seller subtotal INR.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
